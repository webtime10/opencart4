{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				<button type="submit" form="form-{{ extensionType }}" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fas fa-save"></i></button>
				<a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fas fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div class="card">
			<div class="card-body">
				<form id="form-{{ extensionType }}" action="{{ save }}" method="post" data-oc-toggle="ajax">
					<ul class="nav nav-tabs">
						<li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ tab_general }}</a></li>
						<li class="nav-item"><a href="#tab-data" data-bs-toggle="tab" class="nav-link">{{ tab_data }}</a></li>
					</ul>
					<div class="tab-content">
						<div id="tab-general" class="tab-pane fade">
							<legend>{% if extension_description %}{{ extension_description }}{% else %}{{ text_headline }}{% endif %}</legend>
							<div class="row mb-3">
								<div class="col-sm-10">
									<p>{{ text_translation }}: {{ text_translator }}<br>
									{{ text_module_version }}: {{ language_ukrainian_version }}</p>
									<p>{{ text_improvement }}</p>
								</div>
							</div>
							<form id="form-language" action="{{ save }}" method="post" data-oc-toggle="ajax">
								{% if _context[extensionType ~ '_' ~ extensionCode ~ '_ua_status'] %}
									<div class="row mb-3">
										<label for="input-ua-status" class="col-sm-2 col-form-label">{{ entry_uk_ua_status }}</label>
										<div class="col-sm-10">
											<div class="form-check form-switch form-switch-lg">
												<input type="checkbox" name="{{ extensionType }}_{{ extensionCode }}_uk_ua_status" value="1" id="input-ua-status" class="form-check-input"{% if _context[extensionType ~ '_' ~ extensionCode ~ '_ua_status'] %} checked{% endif %}/>
											</div>
										</div>
									</div>
								{% endif %}
								<div class="row mb-3">
									<label for="input-status" class="col-sm-2 col-form-label">{{ entry_module_status }}</label>
									<div class="col-sm-10">
										<div class="form-check form-switch form-switch-lg">
											<input type="hidden" name="{{ extensionType }}_{{ extensionCode }}_status" value="0"/>
											<input type="checkbox" name="{{ extensionType }}_{{ extensionCode }}_status" value="1" id="input-status" class="form-check-input"{% if _context[extensionType ~ '_' ~ extensionCode ~ '_status'] %} checked{% endif %}/>
										</div>
									</div>
								</div>
							</form>
						</div>
						<div id="tab-data" class="tab-pane fade">
							{% if extension_store %}
								<div class="row mb-3{% if extension_store_required %} required{% endif %}">
									<label class="col-sm-2 col-form-label">{{ entry_store }}</label>
									<div class="col-sm-10">
										<div class="form-control" style="height: 100px; overflow: auto;">
											{% for store in stores %}
												<div class="form-check">
													<input type="checkbox" name="{{ extensionType }}_{{ extensionCode }}_store[]" value="{{ store.store_id }}" id="input-store-{{ store.store_id }}" class="form-check-input"{% if store.store_id in _context[extensionType ~ '_' ~ extensionCode ~ '_store'] %} checked{% endif %}/> <label for="input-store-{{ store.store_id }}" class="form-check-label">{{ store.full_name }} {{ store.name }}</label>
												</div>
											{% endfor %}
										</div>
										<div id="error-store" class="invalid-feedback"></div>
									</div>
								</div>
							{% endif %}
							<div class="row mb-3">
								<label class="col-sm-2 col-form-label">{{ text_select_options }}</label>
								<div class="col-sm-10">
									<div class="form-group checkbox-grid">
										<div class="checkbox-control">
											<input type="checkbox" id="selectAll" />
											<label for="selectAll">{{ entry_select_all }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="seo_url" class="form-check-input checkbox-item" id="seo_url">
											<label for="seo_url" class="form-check-label">{{ entry_add_seourl }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="currency" class="form-check-input checkbox-item" id="currency">
											<label for="currency" class="form-check-label">{{ entry_add_uah }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="country_zones" class="form-check-input checkbox-item" id="country_zones">
											<label for="country_zones" class="form-check-label">{{ entry_country_zones }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="customer_groups" class="form-check-input checkbox-item" id="customer_groups">
											<label for="customer_groups" class="form-check-label">{{ entry_customer_groups }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="units_weights" class="form-check-input checkbox-item" id="units_weights">
											<label for="units_weights" class="form-check-label">{{ entry_units_weights }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="info_pages" class="form-check-input checkbox-item" id="info_pages">
											<label for="info_pages" class="form-check-label">{{ entry_infopages }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="options" class="form-check-input checkbox-item" id="options">
											<label for="options" class="form-check-label">{{ entry_options }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="order_statuses" class="form-check-input checkbox-item" id="order_statuses">
											<label for="order_statuses" class="form-check-label">{{ entry_order_statuses }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="returns" class="form-check-input checkbox-item" id="returns">
											<label for="returns" class="form-check-label">{{ entry_returns }}</label>
										</div>
										<div class="form-check form-switch form-switch-sm">
											<input type="checkbox" name="options[]" value="availability_statuses" class="form-check-input checkbox-item" id="availability_statuses">
											<label for="availability_statuses" class="form-check-label">{{ entry_availability_statuses }}</label>
										</div>
									</div>
									<div id="messageContainer" class="d-none alert alert-success"></div>
									<button type="submit" id="executeButton" name="execute" class="btn btn-success mt-3">{{ button_execute }}</button>
								</div>
							</div>
							<div class="row mb-3">
								<label for="input-remove-all" class="col-sm-2 col-form-label">{{ entry_remove_all }}</label>
								<div class="col-sm-10">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="{{ extensionType }}_{{ extensionCode }}_remove_all" value="0"/>
										<input type="checkbox" name="{{ extensionType }}_{{ extensionCode }}_remove_all" value="1" id="input-remove-all" class="form-check-input"{% if _context[extensionType ~ '_' ~ extensionCode ~ '_remove_all'] %} checked{% endif %}/>
									</div>
									<div class="form-text">{{ help_remove_all }}</div>
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<style>
	.checkbox-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}
	.checkbox-control {
		margin-bottom: 10px;
	}
</style>
<script>
	$(document).ready(function () {
		// збереження активної вкладки
		var activeTab = localStorage.getItem('activeTab');
		if (activeTab) {
			$(`[href="${activeTab}"]`).tab('show');
			$(activeTab).addClass('active show');
		} else {
			var firstTab = $('.nav-link:first').attr('href');
			$(`[href="${firstTab}"]`).tab('show');
			$(firstTab).addClass('active show');
		}
		$('.nav-link').on('shown.bs.tab', function (e) {
			$('.tab-pane').removeClass('active show');
			$($(e.target).attr('href')).addClass('active show');
			localStorage.setItem('activeTab', $(e.target).attr('href'));
		});
	});

	// тултіп для кнопки додавання перекладів
	document.getElementById('executeButton').addEventListener('click', async function (event) {
		const button = this;
		try {
			const success = await performOperation();
			if (success) {
				const tooltip = new bootstrap.Tooltip(button, {
					title: "Операцію виконано. Перевірте наявнісь обраних даних",
					placement: "right",
					trigger: "manual"
				});
				tooltip.show();
				setTimeout(() => {
					tooltip.hide();
					tooltip.dispose();
				}, 3000);
			}
		} catch (error) {
			console.error("Помилка:", error);
		}
	});
	async function performOperation() {
		return new Promise((resolve) => {
			setTimeout(() => resolve(true), 1000);
		});
	}

	// вибір всіх чекбоксів
	const selectAllCheckbox = document.getElementById('selectAll');
	const checkboxes = document.querySelectorAll('.checkbox-item');
	selectAllCheckbox.addEventListener('change', function() {
		checkboxes.forEach(checkbox => {
			checkbox.checked = this.checked;
		});
	});
</script>
{{ footer }}