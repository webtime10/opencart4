{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-wt-lang" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-wt-lang">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_wt_lang_status" id="input-status" class="form-select">
                {% if module_wt_lang_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-hreflang">{{ entry_hreflang }}</label>
            <div class="col-sm-10">
              <select name="module_wt_lang_hreflang" id="input-hreflang" class="form-select">
                {% if module_wt_lang_hreflang %}
                <option value="1" selected="selected">{{ text_yes }}</option>
                <option value="0">{{ text_no }}</option>
                {% else %}
                <option value="1">{{ text_yes }}</option>
                <option value="0" selected="selected">{{ text_no }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-xdefault">{{ entry_xdefault }}</label>
            <div class="col-sm-10">
              <select name="module_wt_lang_xdefault" id="input-xdefault" class="form-select">
                {% if module_wt_lang_xdefault %}
                <option value="1" selected="selected">{{ text_yes }}</option>
                <option value="0">{{ text_no }}</option>
                {% else %}
                <option value="1">{{ text_yes }}</option>
                <option value="0" selected="selected">{{ text_no }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_default_language }}</label>
            <div class="col-sm-10">
              <p class="form-text">{{ help_default }}</p>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td class="text-center" style="width:80px">{{ entry_default_language }}</td>
                  <td>{{ column_language }}</td>
                  <td style="width:160px">{{ column_prefix }}</td>
                  <td style="width:160px">{{ column_hreflang }}</td>
                  <td class="text-center" style="width:120px">{{ column_status }}</td>
                </tr>
              </thead>
              <tbody>
                {% for language in languages %}
                <tr>
                  <td class="text-center">
                    <input type="radio" name="module_wt_lang_default" value="{{ language.code }}"{% if module_wt_lang_default == language.code %} checked="checked"{% endif %}/>
                  </td>
                  <td>{{ language.name }} <small class="text-muted">({{ language.code }})</small></td>
                  <td>
                    <input type="text" name="module_wt_lang_language[{{ language.code }}][prefix]" value="{{ language.prefix }}" class="form-control wt-lang-prefix" data-code="{{ language.code }}" placeholder="en"/>
                    <input type="hidden" name="module_wt_lang_language[{{ language.code }}][default]" value="0" class="wt-lang-default-flag"/>
                  </td>
                  <td>
                    <input type="text" name="module_wt_lang_language[{{ language.code }}][hreflang]" value="{{ language.hreflang }}" class="form-control" placeholder="en"/>
                  </td>
                  <td class="text-center">
                    <select name="module_wt_lang_language[{{ language.code }}][status]" class="form-select">
                      {% if language.status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <p class="form-text">{{ help_prefix }}<br/>{{ help_hreflang }}</p>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function () {
  function syncDefaultPrefix() {
    var def = document.querySelector('input[name="module_wt_lang_default"]:checked');
    def = def ? def.value : '';
    document.querySelectorAll('.wt-lang-prefix').forEach(function (el) {
      if (el.dataset.code === def) {
        el.value = '';
        el.readOnly = true;
      } else {
        el.readOnly = false;
      }
    });
  }
  document.querySelectorAll('input[name="module_wt_lang_default"]').forEach(function (el) {
    el.addEventListener('change', syncDefaultPrefix);
  });
  syncDefaultPrefix();
})();
//--></script>
{{ footer }}
