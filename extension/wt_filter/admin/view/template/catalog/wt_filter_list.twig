{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ seo_pages }}" data-bs-toggle="tooltip" title="{{ button_seo_pages }}" class="btn btn-success"><i class="fa-solid fa-globe"></i> {{ button_seo_pages }}</a>
        <a href="{{ module }}" class="btn btn-primary"><i class="fa-solid fa-gear"></i> {{ button_module }}</a>
        <button type="button" data-bs-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-wt-filter').submit() : false;"><i class="fa-solid fa-trash"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_hint_copy }}</div>
    <div class="card wt-filter-panel">
      <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }}</div>
      <div class="card-body">
        <div class="wt-filter-well border rounded p-3 mb-3">
          <div class="row">
            <div class="col-sm-6">
              <div class="mb-3">
                <label class="form-label" for="input-name">{{ entry_name }}</label>
                <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              </div>
              <div class="mb-3">
                <label class="form-label" for="input-category-id">{{ entry_category }}</label>
                <select name="filter_category_id" id="input-category-id" class="form-select">
                  <option value="">{{ text_all }}</option>
                  {% for category in categories %}
                    <option value="{{ category.category_id }}"{% if category.category_id == filter_category_id %} selected{% endif %}>{{ category.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="mb-3">
                <label class="form-label" for="input-type">{{ entry_type }}</label>
                <select name="filter_type" id="input-type" class="form-select">
                  <option value="">{{ text_all }}</option>
                  {% for key, type in types %}
                    <option value="{{ key }}"{% if key == filter_type %} selected{% endif %}>{{ type }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label" for="input-status">{{ entry_status }}</label>
                <select name="filter_status" id="input-status" class="form-select">
                  <option value="">{{ text_all }}</option>
                  <option value="1"{% if filter_status == '1' or filter_status == 1 %} selected{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if filter_status == '0' or filter_status is same as(0) %} selected{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
              <button type="button" id="button-filter" class="btn btn-primary float-end"><i class="fa-solid fa-magnifying-glass"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-wt-filter">
          <div class="table-responsive wt-filter-table-wrap">
            <table class="table wt-filter-list">
              <thead>
                <tr>
                  <th class="wt-col-select">
                    <input type="checkbox" class="wt-checkbox form-check-input" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);"/>
                  </th>
                  <th class="wt-col-option text-start">
                    <a href="{{ sort_name }}"{% if sort == 'od.name' %} class="{{ order|lower }}"{% endif %}>{{ column_name }}</a>
                  </th>
                  <th class="wt-col-type text-start">{{ column_type }}</th>
                  <th class="wt-col-values text-start">{{ column_values }}</th>
                  <th class="wt-col-categories text-start">{{ column_categories }}</th>
                  <th class="wt-col-sort text-center">
                    <a href="{{ sort_order }}"{% if sort == 'o.sort_order' %} class="{{ order|lower }}"{% endif %}>{{ column_sort_order }}</a>
                  </th>
                  <th class="wt-col-expanded text-center" colspan="2">
                    <div class="wt-expanded-head">{{ column_expanded }}</div>
                    <div class="wt-expanded-sub">
                      <span title="{{ help_expanded_desktop }}" data-bs-toggle="tooltip">{{ column_expanded_desktop }}</span>
                      <span title="{{ help_expanded_mobile }}" data-bs-toggle="tooltip">{{ column_expanded_mobile }}</span>
                    </div>
                  </th>
                  <th class="wt-col-status text-center">{{ column_status }}</th>
                  <th class="wt-col-action text-center">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody id="wt-filter-sortable">
                {% if options %}
                  {% for option in options %}
                    <tr data-option-id="{{ option.option_id }}">
                      <td class="wt-col-select">
                        <div class="wt-select-cell">
                          <input type="checkbox" name="selected[]" value="{{ option.option_id }}" class="wt-checkbox form-check-input"{% if option.selected %} checked{% endif %}/>
                          <span class="wt-drag-handle" title="{{ text_drag }}" data-bs-toggle="tooltip"><i class="fa-solid fa-bars"></i></span>
                        </div>
                      </td>
                      <td class="wt-col-option text-start">
                        <span class="wt-option-name">{{ option.name }}</span>
                      </td>
                      <td class="wt-col-type text-start">
                        <div class="wt-type-select wt-type-select--{{ option.type ? option.type : 'none' }}">
                          <select class="edit wt-type-select__control" name="type" data-option-id="{{ option.option_id }}">
                            <option value="">{{ text_none }}</option>
                            {% for key, type in types %}
                              <option value="{{ key }}"{% if key == option.type %} selected{% endif %}>{{ type }}</option>
                            {% endfor %}
                          </select>
                          <i class="fa-solid fa-chevron-down wt-type-select__icon"></i>
                        </div>
                      </td>
                      <td class="wt-col-values text-start">
                        <div class="wt-tags">
                          {% for value in option.values %}
                            <span class="wt-badge wt-badge--value">{{ value }}</span>
                          {% endfor %}
                          {% if option.values_extra > 0 %}
                            <span class="wt-badge wt-badge--more" data-bs-toggle="tooltip" title="{{ option.values_more_title|e('html_attr') }}">{{ option.values_more_label }}</span>
                          {% endif %}
                        </div>
                      </td>
                      <td class="wt-col-categories text-start">
                        <div class="wt-tags">
                          {% for category in option.categories %}
                            <span class="wt-badge wt-badge--category">{{ category }}</span>
                          {% endfor %}
                          {% if option.categories_extra > 0 %}
                            <span class="wt-badge wt-badge--more" data-bs-toggle="tooltip" title="{{ option.categories_more_title|e('html_attr') }}">{{ option.categories_more_label }}</span>
                          {% endif %}
                        </div>
                      </td>
                      <td class="wt-col-sort text-center">
                        <input type="text" name="sort_order" value="{{ option.sort_order }}" class="edit form-control wt-sort-input" data-option-id="{{ option.option_id }}" inputmode="numeric"/>
                      </td>
                      <td class="wt-col-expanded text-center">
                        <label class="wt-toggle" title="{% if option.expanded_desktop %}{{ text_expanded_open }}{% else %}{{ text_expanded_closed }}{% endif %}" data-bs-toggle="tooltip">
                          <input type="checkbox" class="edit" name="expanded_desktop" value="1" data-option-id="{{ option.option_id }}"{% if option.expanded_desktop %} checked{% endif %}/>
                          <span class="wt-toggle__track"><span class="wt-toggle__thumb"></span></span>
                        </label>
                      </td>
                      <td class="wt-col-expanded text-center">
                        <label class="wt-toggle" title="{% if option.expanded_mobile %}{{ text_expanded_open }}{% else %}{{ text_expanded_closed }}{% endif %}" data-bs-toggle="tooltip">
                          <input type="checkbox" class="edit" name="expanded_mobile" value="1" data-option-id="{{ option.option_id }}"{% if option.expanded_mobile %} checked{% endif %}/>
                          <span class="wt-toggle__track"><span class="wt-toggle__thumb"></span></span>
                        </label>
                      </td>
                      <td class="wt-col-status text-center">
                        <label class="wt-toggle" title="{% if option.status %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}" data-bs-toggle="tooltip">
                          <input type="checkbox" class="edit" name="status" value="1" data-option-id="{{ option.option_id }}"{% if option.status %} checked{% endif %}/>
                          <span class="wt-toggle__track"><span class="wt-toggle__thumb"></span></span>
                        </label>
                      </td>
                      <td class="wt-col-action text-center">
                        <a href="{{ option.edit }}" class="wt-icon-btn" data-bs-toggle="tooltip" title="{{ text_edit }}">
                          <i class="fa-solid fa-pencil"></i>
                        </a>
                      </td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr class="wt-empty-row">
                    <td class="text-center" colspan="10">{{ text_no_results }}</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row wt-filter-footer">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-end">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
wt_filter = wt_filter || {};
wt_filter.php = {
  user_token: '{{ user_token }}',
  text_enabled: '{{ text_enabled|e('js') }}',
  text_disabled: '{{ text_disabled|e('js') }}',
  text_expanded_open: '{{ text_expanded_open|e('js') }}',
  text_expanded_closed: '{{ text_expanded_closed|e('js') }}'
};
//--></script>
{{ footer }}
