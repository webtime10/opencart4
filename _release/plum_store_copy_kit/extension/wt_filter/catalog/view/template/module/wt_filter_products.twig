{% if products %}
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4" id="wt-filter-products">
  {% for product in products %}
  <div class="col mb-3">
    <div class="product-thumb">
      <div class="image"><a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-fluid"/></a></div>
      <div class="content">
        <div class="description">
          <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
          <p>{{ product.description }}</p>
          {% if product.price %}
          <div class="price">
            {% if not product.special %}
              <span class="price-new">{{ product.price }}</span>
            {% else %}
              <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
            {% endif %}
            {% if product.tax %}<span class="price-tax">{{ text_tax }} {{ product.tax }}</span>{% endif %}
          </div>
          {% endif %}
        </div>
        <div class="button-group">
          <button type="button" class="btn btn-primary btn-sm" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa-solid fa-shopping-cart"></i></button>
          <button type="button" class="btn btn-light btn-sm" data-bs-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa-solid fa-heart"></i></button>
          <button type="button" class="btn btn-light btn-sm" data-bs-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa-solid fa-arrow-right-arrow-left"></i></button>
        </div>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
<div class="row" id="wt-filter-pagination">
  <div class="col-sm-6 text-start">{{ pagination }}</div>
  <div class="col-sm-6 text-end">{{ results }}</div>
</div>
{% else %}
<div id="wt-filter-products">
  <p>{{ text_empty }}</p>
</div>
<div id="wt-filter-pagination"></div>
{% endif %}
