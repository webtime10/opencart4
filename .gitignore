cat << 'EOF' > .gitignore
# Конфиги (содержат локальные пути и доступы к БД)
/config.php
/admin/config.php

# Кэш, логи и сессии OpenCart 4
/system/storage/cache/*
/system/storage/logs/*
/system/storage/modification/*
/system/storage/session/*
/system/storage/download/*
!/system/storage/cache/index.html
!/system/storage/logs/index.html
!/system/storage/modification/index.html

# Картинки товаров и кэш изображений
/image/cache/*
/image/catalog/*
!/image/catalog/index.html

# Временные файлы и архив
*.tmp
*.log
.DS_Store
EOF
